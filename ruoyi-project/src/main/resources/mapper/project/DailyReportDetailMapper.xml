<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.mapper.DailyReportDetailMapper">

    <resultMap type="DailyReportDetail" id="DetailResult">
        <result property="detailId"          column="detail_id"      />
        <result property="reportId"          column="report_id"      />
        <result property="projectId"         column="project_id"     />
        <result property="projectStage"      column="project_stage"  />
        <result property="workHours"         column="work_hours"     />
        <result property="workContent"       column="work_content"   />
        <result property="entryType"         column="entry_type"     />
        <result property="leaveHours"        column="leave_hours"    />
        <result property="delFlag"           column="del_flag"       />
        <result property="createBy"          column="create_by"      />
        <result property="createTime"        column="create_time"    />
        <result property="updateBy"          column="update_by"      />
        <result property="updateTime"        column="update_time"    />
        <result property="remark"            column="remark"         />
        <result property="projectName"       column="project_name"   />
        <result property="projectCode"       column="project_code"   />
        <result property="projectStageName"  column="stage_name"     />
        <result property="subProjectId"      column="sub_project_id" />
        <result property="workCategory"      column="work_category"  />
        <result property="subProjectName"    column="sub_project_name"/>
    </resultMap>

    <!-- 根据日报ID查询明细列表（关联项目名称、编号、阶段名称） -->
    <select id="selectByReportId" parameterType="Long" resultMap="DetailResult">
        select
            dd.detail_id, dd.report_id, dd.project_id, dd.project_stage,
            dd.entry_type, dd.leave_hours, dd.work_hours, dd.work_content, dd.del_flag,
            dd.create_by, dd.create_time, dd.update_by, dd.update_time, dd.remark,
            dd.sub_project_id, dd.work_category,
            p.project_name,
            p.project_code,
            sp.task_name as sub_project_name,
            dict.dict_label as stage_name
        from pm_daily_report_detail dd
        left join pm_project p on dd.project_id = p.project_id
        left join pm_task sp on dd.sub_project_id = sp.task_id
        left join sys_dict_data dict on dd.project_stage COLLATE utf8mb4_unicode_ci = dict.dict_value and dict.dict_type = 'sys_xmjd'
        where dd.report_id = #{reportId}
        order by dd.detail_id
    </select>

    <!-- 新增单条明细 -->
    <insert id="insertDetail" parameterType="DailyReportDetail" useGeneratedKeys="true" keyProperty="detailId">
        insert into pm_daily_report_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reportId != null">report_id,</if>
            <if test="projectId != null">project_id,</if>
            <if test="projectStage != null and projectStage != ''">project_stage,</if>
            <if test="workHours != null">work_hours,</if>
            <if test="workContent != null and workContent != ''">work_content,</if>
            <if test="entryType != null">entry_type,</if>
            <if test="leaveHours != null">leave_hours,</if>
            <if test="subProjectId != null">sub_project_id,</if>
            <if test="workCategory != null">work_category,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reportId != null">#{reportId},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="projectStage != null and projectStage != ''">#{projectStage},</if>
            <if test="workHours != null">#{workHours},</if>
            <if test="workContent != null and workContent != ''">#{workContent},</if>
            <if test="entryType != null">#{entryType, jdbcType=VARCHAR},</if>
            <if test="leaveHours != null">#{leaveHours, jdbcType=DECIMAL},</if>
            <if test="subProjectId != null">#{subProjectId},</if>
            <if test="workCategory != null">#{workCategory},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <!-- 批量新增明细 -->
    <insert id="batchInsert" parameterType="java.util.List">
        insert into pm_daily_report_detail (report_id, project_id, project_stage, entry_type, leave_hours, work_hours, work_content, sub_project_id, work_category, del_flag, create_by, create_time)
        values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.reportId}, #{item.projectId}, #{item.projectStage},
             #{item.entryType, jdbcType=VARCHAR},
             #{item.leaveHours, jdbcType=DECIMAL},
             #{item.workHours},
             #{item.workContent, jdbcType=VARCHAR},
             #{item.subProjectId, jdbcType=BIGINT},
             #{item.workCategory, jdbcType=VARCHAR},
             '0', #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>

    <!-- 根据日报ID删除明细（物理删除） -->
    <delete id="deleteByReportId" parameterType="Long">
        delete from pm_daily_report_detail where report_id = #{reportId}
    </delete>

    <!--
      【015】按「作用范围」删除明细：只删填报人本次提交有能力表达的那部分。
      · project_id is null  → 非项目工时（请假/倒休/年假等），在所有填写入口均始终可见，
                              未出现在提交中即视为主动删除，故无条件纳入范围（FR-005）
      · project_id in (...)  → 填报人当前可填项目的工时
      范围之外的明细（已结项项目的历史工时等）被本语句跳过 → 原样保留（FR-001）

      ⚠️ <if> 空集守卫不可删：填报人无任何可填项目时集合为空，
         若无守卫会生成 "in ()" 语法错误；有守卫则退化为「仅删非项目工时」，语义正确。
    -->
    <delete id="deleteByReportIdInScope">
        delete from pm_daily_report_detail
        where report_id = #{reportId}
          and (
            project_id is null
            <if test="visibleProjectIds != null and visibleProjectIds.size() > 0">
                or project_id in
                <foreach item="pid" collection="visibleProjectIds" open="(" separator="," close=")">
                    #{pid}
                </foreach>
            </if>
          )
    </delete>

    <!-- 统计指定项目在所有日报中的总工时(小时) -->
    <select id="sumWorkHoursByProjectId" parameterType="Long" resultType="java.math.BigDecimal">
        select coalesce(sum(work_hours), 0)
        from pm_daily_report_detail
        where project_id = #{projectId}
          and entry_type = 'work'
          and del_flag = '0'
    </select>

    <!-- 统计指定子任务在所有日报中的总工时(小时) -->
    <select id="sumWorkHoursBySubProjectId" parameterType="Long" resultType="java.math.BigDecimal">
        select coalesce(sum(work_hours), 0)
        from pm_daily_report_detail
        where sub_project_id = #{subProjectId}
          and entry_type = 'work'
          and del_flag = '0'
    </select>

    <!-- 根据日报ID批量删除明细（物理删除） -->
    <delete id="deleteByReportIds" parameterType="String">
        delete from pm_daily_report_detail where report_id in
        <foreach item="reportId" collection="array" open="(" separator="," close=")">
            #{reportId}
        </foreach>
    </delete>

    <select id="countBySubProjectId" parameterType="Long" resultType="int">
        select count(*) from pm_daily_report_detail where sub_project_id = #{subProjectId}
    </select>

    <!-- 【015】该日报当前剩余的明细条数，用于删除时判断主记录去留（FR-014） -->
    <select id="countByReportId" parameterType="Long" resultType="int">
        select count(*) from pm_daily_report_detail where report_id = #{reportId}
    </select>

    <!--
      【015】该日报剩余 work 类型明细的工时之和，用于保留主记录时重算当日汇总（INV-D2）。
      口径与 saveDailyReport 计算 totalWorkHours 严格一致：只累加 entry_type='work'，
      假期类（请假/倒休/年假等）不计入当日汇总工时。
    -->
    <select id="sumWorkHoursByReportId" parameterType="Long" resultType="java.math.BigDecimal">
        select coalesce(sum(work_hours), 0)
        from pm_daily_report_detail
        where report_id = #{reportId}
          and entry_type = 'work'
    </select>
</mapper>
